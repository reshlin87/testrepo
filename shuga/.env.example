# SQLite for local dev. For production use Postgres (change provider in prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Facebook: https://developers.facebook.com/apps
# Valid OAuth redirect URI: http://localhost:3000/api/auth/callback/facebook
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
